# Docker Compose environment variables
# Copy this file to .env and fill in the values before running docker compose up

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=cargolink

# Backend
JWT_SECRET=changeme-use-a-long-random-string
JWT_EXPIRATION=7d
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Password de la cuenta admin@cargolink.com que crea el seed. Si la seteás, el
# seed la reescribe en cada arranque y esta variable pasa a ser la fuente de
# verdad de esa credencial. Vacía = el seed usa su fallback al crear la cuenta y
# después no la pisa (solo apto para dev local).
ADMIN_PASSWORD=

# SMTP — leave SMTP_USER empty to fall back to Ethereal (dev preview, no
# real delivery). To enable real delivery, fill in SMTP_USER and
# SMTP_PASSWORD. Gmail requires 2FA + an App Password from your Google
# Account (see https://myaccount.google.com/apppasswords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
