# Variables del entorno DEV. Copiá a dev.tfvars (gitignoreado) y completá.
# Se aplica en el workspace "dev": terraform workspace select dev && terraform apply -var-file=dev.tfvars
project_id  = "cargo-link-2026"
environment = "dev"
region      = "southamerica-east1"

# Imágenes en el Artifact Registry de dev (repo "cargolink-dev").
# Para el bootstrap inicial; después CI las actualiza por SHA.
backend_image  = "southamerica-east1-docker.pkg.dev/cargo-link-2026/cargolink-dev/cargolink-backend:bootstrap"
frontend_image = "" # fase 2: se completa tras conocer la URL del backend dev

# Dev escala a cero para ahorrar (acepta cold starts + re-seed idempotente).
backend_min_instances = 0
backend_max_instances = 1

db_deletion_protection = false

# OJO: terraform.tfvars (prod) se auto-carga SIEMPRE, incluso al aplicar dev con
# -var-file=dev.tfvars. Para que dev NO herede las creds SMTP de prod, vacialas
# explícitamente acá. (Para SMTP propio en dev, poné tus creds en lugar de "".)
smtp_password = ""
smtp_user     = ""
# smtp_host     = "smtp.gmail.com"
# smtp_from     = "CargoLink Dev <tu-cuenta@gmail.com>"

# ─── Dominios custom de dev (opcional) ───
# MISMO ojo que con SMTP: si prod define frontend_domain/backend_domain en
# terraform.tfvars, dev los heredaría. Seteá los de dev (o "" para no crear LB)
# acá explícitamente. Cada entorno tiene su propio LB → su propia IP anycast.
# frontend_domain = "dev.cargolink.com.ar"
# backend_domain  = "api.dev.cargolink.com.ar"
