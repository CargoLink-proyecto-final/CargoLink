generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CARGO_GENERATOR
  TRANSPORTER
  ADMIN
  COMPANY_ADMIN
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LoadStatus {
  PUBLISHED
  ASSIGNED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum TripStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PostulationStatus {
  PENDING
  NEGOTIATING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum DocumentType {
  DNI_FRONT
  DNI_BACK
  LICENSE_FRONT
  LICENSE_BACK
  AFIP_CONSTANCIA
  VEHICLE_CARD
  INSURANCE
  VTV
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VehicleType {
  CAMION
  CAMIONETA
  FURGON
  SEMIRREMOLQUE
  BATEA
  OTRO
}

model User {
  id                        String    @id @default(uuid())
  email                     String    @unique
  password                  String
  firstName                 String    @map("first_name")
  lastName                  String    @map("last_name")
  phone                     String?
  role                      Role      @default(CARGO_GENERATOR)
  companyName               String?   @map("company_name")
  // Rubro o actividad de la empresa del publicador — contexto para los
  // transportistas y base para segmentaciones futuras.
  industry                  String?   @map("industry")
  avatarUrl                 String?   @map("avatar_url")
  // Zona de influencia del transportista (P12): centro (lat/lng) + radio del
  // área habitual de trabajo. Se usa para priorizar cargas cercanas en
  // /loads/available. Todo opcional — null = sin zona definida.
  zoneLat                   Float?    @map("zone_lat")
  zoneLng                   Float?    @map("zone_lng")
  zoneRadiusKm              Float?    @map("zone_radius_km")
  // Token de Expo del dispositivo, para push con la app cerrada. Uno solo por
  // usuario: el último dispositivo que se registró gana. Soportar varios
  // dispositivos a la vez requeriría una tabla aparte.
  expoPushToken             String?   @map("expo_push_token")
  // Perfil de transportista (P13): documentación de identidad/habilitación +
  // vehículo. CUIT/CUIL y datos de la licencia son atributos del conductor
  // (no del archivo escaneado que los respalda, ver model Document). La
  // declaración jurada se registra con versión + timestamp para poder
  // demostrar qué texto exacto aceptó cada usuario si hace falta más adelante.
  cuit                      String?   @map("cuit")
  licenseCategory           String?   @map("license_category")
  licenseExpiresAt          DateTime? @map("license_expires_at")
  termsAcceptedAt           DateTime? @map("terms_accepted_at")
  termsAcceptedVersion      String?   @map("terms_accepted_version")
  isActive                  Boolean   @default(true) @map("is_active")
  resetToken                String?   @map("reset_token")
  resetTokenExp             DateTime? @map("reset_token_exp")
  emailVerified             Boolean   @default(false) @map("email_verified")
  emailVerificationToken    String?   @unique @map("email_verification_token")
  emailVerificationTokenExp DateTime? @map("email_verification_token_exp")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  // Company membership (TRANSPORTER) — null = independent / not in a company
  companyId String?  @map("company_id")
  company   Company? @relation("CompanyMembers", fields: [companyId], references: [id])

  // Company ownership (COMPANY_ADMIN) — the company this user owns, if any
  ownedCompany Company? @relation("CompanyOwner")

  // Join requests submitted as a transporter
  companyJoinRequests CompanyJoinRequest[] @relation("DriverRequests")

  // Shipper relations
  loads Load[] @relation("ShipperLoads")

  // Carrier relations
  trips Trip[] @relation("CarrierTrips")

  // Postulations submitted as a transporter
  postulations Postulation[] @relation("TransporterPostulations")

  // Messages
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")

  // Ratings
  givenRatings    Rating[] @relation("RatingFrom")
  receivedRatings Rating[] @relation("RatingTo")

  // Role-change audit (who changed this user's role / changes this user made as admin)
  roleChangesReceived RoleChangeLog[] @relation("RoleChangeTarget")
  roleChangesMade     RoleChangeLog[] @relation("RoleChangeAuthor")

  // Perfil de transportista: vehículo propio + documentos subidos
  vehicle   Vehicle?
  documents Document[]

  @@index([companyId])
  // Cada registro de dispositivo desasocia el token de su dueño anterior con un
  // `where: { expoPushToken: token }`. Sin índice eso es un seq scan sobre users.
  @@index([expoPushToken])
  @@map("users")
}

model Company {
  id      String @id @default(uuid())
  name    String
  ownerId String @unique @map("owner_id")
  owner   User   @relation("CompanyOwner", fields: [ownerId], references: [id])

  members  User[]               @relation("CompanyMembers")
  requests CompanyJoinRequest[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("companies")
}

model CompanyJoinRequest {
  id            String  @id @default(uuid())
  companyId     String  @map("company_id")
  company       Company @relation(fields: [companyId], references: [id])
  transporterId String  @map("transporter_id")
  transporter   User    @relation("DriverRequests", fields: [transporterId], references: [id])

  status    JoinRequestStatus @default(PENDING)
  createdAt DateTime          @default(now()) @map("created_at")
  decidedAt DateTime?         @map("decided_at")

  @@unique([companyId, transporterId])
  @@index([companyId, status])
  @@index([transporterId])
  @@map("company_join_requests")
}

model Load {
  id        String @id @default(uuid())
  shipperId String @map("shipper_id")
  shipper   User   @relation("ShipperLoads", fields: [shipperId], references: [id])

  title         String
  description   String?
  originAddress String     @map("origin_address")
  originLat     Float      @map("origin_lat")
  originLng     Float      @map("origin_lng")
  destAddress   String     @map("dest_address")
  destLat       Float      @map("dest_lat")
  destLng       Float      @map("dest_lng")
  // Ciudad del padrón oficial. Opcional: las cargas anteriores al padrón (y las
  // que llegan desde mobile con dirección libre) se resuelven por backfill best
  // effort y pueden quedar en null.
  originCityId  String?    @map("origin_city_id")
  originCity    City?      @relation("LoadOriginCity", fields: [originCityId], references: [id])
  destCityId    String?    @map("dest_city_id")
  destCity      City?      @relation("LoadDestCity", fields: [destCityId], references: [id])
  cargoType     String     @map("cargo_type")
  weight        Float
  volume        Float?
  // Información logística del bulto (opcional) — habilita evaluar
  // compatibilidad entre cargas para compartir un mismo viaje.
  packageCount  Int?       @map("package_count")
  heightCm      Float?     @map("height_cm")
  widthCm       Float?     @map("width_cm")
  lengthCm      Float?     @map("length_cm")
  pickupDate    DateTime   @map("pickup_date")
  deliveryDate  DateTime?  @map("delivery_date")
  // Opcional: si el publicador no fija precio, la carga sale "a convenir" y el
  // precio lo define la postulación del transportista (proposedPrice, que en ese
  // caso pasa a ser obligatorio).
  price         Float?
  // Columna retirada del producto: ya no se lee ni se escribe desde ninguna capa.
  // Se deja para no correr una migración destructiva sobre datos existentes.
  maxBudget     Float?     @map("max_budget")
  status        LoadStatus @default(PUBLISHED)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  trip         Trip?
  postulations Postulation[]

  @@index([shipperId])
  @@index([status])
  @@index([pickupDate])
  @@index([originCityId])
  @@index([destCityId])
  @@index([originLat, originLng])
  @@index([destLat, destLng])
  @@map("loads")
}

model Postulation {
  id                String            @id @default(uuid())
  loadId            String            @map("load_id")
  load              Load              @relation(fields: [loadId], references: [id])
  transporterId     String            @map("transporter_id")
  transporter       User              @relation("TransporterPostulations", fields: [transporterId], references: [id])
  message           String?
  proposedPrice     Float?            @map("proposed_price")
  counterOfferPrice Float?            @map("counter_offer_price")
  lastOfferBy       String?           @map("last_offer_by")
  status            PostulationStatus @default(PENDING)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@unique([loadId, transporterId])
  @@index([loadId, status])
  @@index([transporterId])
  @@map("postulations")
}

model Trip {
  id        String @id @default(uuid())
  loadId    String @unique @map("load_id")
  load      Load   @relation(fields: [loadId], references: [id])
  carrierId String @map("carrier_id")
  carrier   User   @relation("CarrierTrips", fields: [carrierId], references: [id])

  status      TripStatus @default(PENDING)
  currentLat  Float?     @map("current_lat")
  currentLng  Float?     @map("current_lng")
  startedAt   DateTime?  @map("started_at")
  completedAt DateTime?  @map("completed_at")
  // Litros de combustible que el transportista carga al completar el viaje.
  fuelLiters  Float?     @map("fuel_liters")
  // Distancia de la ruta (km) calculada en el backend vía OSRM al completar.
  distanceKm  Float?     @map("distance_km")
  notes       String?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  ratings  Rating[]
  messages Message[]

  @@index([carrierId])
  @@index([status])
  @@map("trips")
}

model Message {
  id         String   @id @default(uuid())
  senderId   String   @map("sender_id")
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String   @map("receiver_id")
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  tripId     String   @map("trip_id")
  trip       Trip     @relation(fields: [tripId], references: [id])
  content    String
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tripId])
  @@index([senderId, receiverId])
  @@index([receiverId, isRead])
  @@map("messages")
}

model Rating {
  id         String   @id @default(uuid())
  tripId     String   @map("trip_id")
  trip       Trip     @relation(fields: [tripId], references: [id])
  fromUserId String   @map("from_user_id")
  fromUser   User     @relation("RatingFrom", fields: [fromUserId], references: [id])
  toUserId   String   @map("to_user_id")
  toUser     User     @relation("RatingTo", fields: [toUserId], references: [id])
  score      Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([tripId, fromUserId])
  @@index([toUserId])
  @@map("ratings")
}

model RoleChangeLog {
  id          String   @id @default(uuid())
  userId      String   @map("user_id") // usuario cuyo rol cambió
  changedById String   @map("changed_by_id") // admin que ejecutó el cambio
  oldRole     Role     @map("old_role")
  newRole     Role     @map("new_role")
  createdAt   DateTime @default(now()) @map("created_at")

  user      User @relation("RoleChangeTarget", fields: [userId], references: [id])
  changedBy User @relation("RoleChangeAuthor", fields: [changedById], references: [id])

  @@index([userId])
  @@map("role_change_logs")
}

// ---------------------------------------------------------------------------
// Perfil de transportista (P13): vehículo + documentación de identidad y
// habilitación. Mientras un TRANSPORTER no complete esto no puede postularse
// a una carga (ver ProfileCompleteGuard) — pero el resto de la app queda
// accesible igual.
// ---------------------------------------------------------------------------

model Vehicle {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  plate String      @unique
  brand String
  model String
  year  Int
  type  VehicleType

  maxWeightKg Float  @map("max_weight_kg")
  maxVolumeM3 Float? @map("max_volume_m3")
  heightCm    Float? @map("height_cm")
  widthCm     Float? @map("width_cm")
  lengthCm    Float? @map("length_cm")

  refrigerated       Boolean @default(false)
  hazardousMaterials Boolean @default(false) @map("hazardous_materials")
  bulkLiquid         Boolean @default(false) @map("bulk_liquid")

  // Vencimientos del vehículo (no del archivo escaneado): atributos propios
  // del vehículo, independientes de si el Document de tipo INSURANCE/VTV que
  // lo respalda está PENDING/APPROVED/REJECTED.
  insuranceExpiresAt DateTime? @map("insurance_expires_at")
  vtvExpiresAt       DateTime? @map("vtv_expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("vehicles")
}

model Document {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  type    DocumentType
  fileUrl String         @map("file_url")
  status  DocumentStatus @default(PENDING)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Un solo documento vigente por tipo y usuario — volver a subir el mismo
  // tipo reemplaza (upsert), no acumula versiones.
  @@unique([userId, type])
  @@index([userId])
  @@map("documents")
}

// ---------------------------------------------------------------------------
// Padrón geográfico oficial (Servicio de Normalización de Datos Geográficos,
// IGN/INDEC vía datos.gob.ar). Son tablas de catálogo: se cargan desde
// prisma/data/argentina-geo.json en el seed y no las edita el usuario.
// ---------------------------------------------------------------------------

model Province {
  id      String  @id @default(uuid())
  // Código oficial INDEC de 2 dígitos (ej. "06" Buenos Aires). Es la clave
  // natural del registro: por acá se hace upsert idempotente del seed.
  code    String  @unique
  name    String  @unique
  // ISO 3166-2 (ej. "AR-B"). Útil para integraciones externas.
  iso     String?
  // El padrón es nacional; queda explícito para autocompletar el formulario y
  // por si algún día entra otro país.
  country String  @default("Argentina")

  cities City[]

  @@map("provinces")
}

model City {
  id         String  @id @default(uuid())
  // ID oficial de localidad censal, 8 dígitos (ej. "06035010").
  code       String  @unique
  name       String
  // Departamento/partido al que pertenece. No se modela como tabla propia
  // porque solo se usa para desambiguar: hay 68 pares (nombre, provincia)
  // repetidos en el padrón que únicamente se distinguen por departamento.
  // Nullable: CABA es la única localidad del padrón sin departamento.
  department String? @map("department")
  // CPA orientativo (fuente GeoNames). Una ciudad grande tiene muchos: se
  // guarda el más cercano al centroide. Null cuando no hubo match confiable.
  postalCode String? @map("postal_code")
  // Centroide de la localidad — habilita ordenar por cercanía sin geocodificar.
  lat        Float
  lng        Float
  // `name` normalizado (sin acentos, minúsculas, sin invisibles) para el
  // type-ahead: ILIKE en Postgres ignora mayúsculas pero NO acentos, así que
  // "cordoba" nunca matcheaba "Córdoba". Lo llena el seed con
  // `normalizeSearchText` — no se expone por la API, es solo clave de búsqueda.
  // Sin índice a propósito: la búsqueda es LIKE 'prefijo%', que un btree con la
  // collation del server no puede servir, y `text_pattern_ops` no sobrevive la
  // introspección de Prisma 5 (deja drift fantasma en cada migrate dev). Sobre
  // 4.027 filas estáticas el seq scan es sub-milisegundo; si el padrón creciera
  // en un orden de magnitud, el próximo paso es un GIN con pg_trgm.
  searchName String  @default("") @map("search_name")

  provinceId String   @map("province_id")
  province   Province @relation(fields: [provinceId], references: [id])

  originLoads Load[] @relation("LoadOriginCity")
  destLoads   Load[] @relation("LoadDestCity")

  @@index([provinceId])
  @@index([name])
  @@map("cities")
}
