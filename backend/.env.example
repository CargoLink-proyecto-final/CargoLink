DATABASE_URL="postgresql://postgres:password@localhost:5432/cargolink?schema=public"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRATION="7d"
PORT=3001
CORS_ORIGIN="http://localhost:3000"
# Directorio donde se guardan los documentos subidos por transportistas (DNI,
# licencia, etc.). En docker-compose apunta a un volumen persistente.
UPLOAD_DIR="./uploads"
