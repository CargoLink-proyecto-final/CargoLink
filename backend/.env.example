DATABASE_URL="postgresql://postgres:password@localhost:5432/cargolink?schema=public"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRATION="7d"
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# Asistente conversacional de creación de carga (chatbot con Gemini).
# API key de Google AI Studio (https://aistudio.google.com/apikey). Es el
# proveedor primario del asistente. Vive SOLO en el backend, nunca en el cliente.
GEMINI_API_KEY=""
# Modelo a usar (default gemini-2.5-flash).
GEMINI_MODEL="gemini-2.5-flash"

# Proveedor de respaldo: se usa solo si Gemini falla (429 por cuota, timeout,
# 5xx). API compatible con OpenAI; key en https://console.groq.com/keys.
# Sin ninguna de las dos keys el asistente funciona igual, en modo básico
# (preguntas del flujo una por una, parseadas con reglas).
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
# Ruta del archivo JSON donde se persiste el flujo editable por el panel admin.
# Opcional; por defecto assistant-flow.config.json junto al proceso del backend.
# ASSISTANT_FLOW_CONFIG_PATH=""
