{
  "cli": {
    "version": ">= 24.7.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://dev.cargolink.com.ar/api",
        "EAS_PROJECT_ID": "1069c26e-a3bd-4919-9461-01599fce42e9"
      },
      "ios": {
        "resourceClass": "medium"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://plataforma.cargolink.com.ar/api",
        "EAS_PROJECT_ID": "1069c26e-a3bd-4919-9461-01599fce42e9"
      },
      "ios": {
        "resourceClass": "medium"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
