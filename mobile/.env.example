# Copiar a `.env` y ajustar. Todas son opcionales para desarrollo local.

# URL del API. Si se deja vacía, la app deduce la IP de la máquina que corre
# Metro y apunta a http://<esa-ip>:3001/api — que es lo que querés para dev
# local, tanto en simulador como en un dispositivo físico en la misma red.
# Completar sólo para apuntar a un backend remoto:
#   EXPO_PUBLIC_API_URL=https://dev.cargolink.com.ar/api
EXPO_PUBLIC_API_URL=

# projectId de EAS (`npx eas-cli init` lo imprime). Sin esta variable
# registerForPushNotifications() devuelve null y las push remotas no llegan;
# las locales, que emite el propio dispositivo, funcionan igual. Acá sirve sólo
# para dev local: los builds en la nube lo toman del `env` de cada perfil de
# `eas.json`, porque este archivo está gitignoreado y no llega al server.
EAS_PROJECT_ID=

# Style de MapLibre para el mapa de seguimiento. Vacío = OpenFreeMap, que sirve
# tiles de OpenStreetMap sin API key ni cuota, igual en iOS y en Android.
# Completar sólo para usar otro proveedor (MapTiler, Stadia, style propio):
#   EXPO_PUBLIC_MAP_STYLE_URL=https://api.maptiler.com/maps/streets/style.json?key=...
EXPO_PUBLIC_MAP_STYLE_URL=
