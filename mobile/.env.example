# Copiar a `.env` y ajustar. Todas son opcionales para desarrollo local.

# URL del API. Si se deja vacía, la app deduce la IP de la máquina que corre
# Metro y apunta a http://<esa-ip>:3001/api — que es lo que querés para dev
# local, tanto en simulador como en un dispositivo físico en la misma red.
# Completar sólo para apuntar a un backend remoto:
#   EXPO_PUBLIC_API_URL=https://dev.cargolink.com.ar/api
EXPO_PUBLIC_API_URL=

# projectId de EAS. Sólo para emitir el token de push remotas en dev local
# (`npx eas-cli init` lo imprime). Para los builds en la nube va en el `env` de
# cada perfil de `eas.json`: este archivo está gitignoreado y no llega al server.
EAS_PROJECT_ID=

# Google Maps en Android. En iOS no hace falta: react-native-maps usa Apple Maps
# con PROVIDER_DEFAULT. Sin esta key el mapa aparece en blanco en Android.
GOOGLE_MAPS_API_KEY_ANDROID=
